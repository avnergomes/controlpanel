{
  "name": "controlpanel",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Observatory: painel de telemetria (pageviews anonimos, LGPD) dos sites do ecossistema Datageo Parana e projetos pessoais.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:world": "py -3 scripts/build_world_paths.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run test:e2e",
    "gas:pull": "clasp pull",
    "gas:push": "clasp push -f",
    "gas:deploy": "clasp deploy -i AKfycbwdSLK3K9_D39sc0UfzYZIM1QEMLxMUudSneAELoqcJjM5ExTSq7ZmMilNzYDx5QK5iMA -d v3",
    "gas:health": "curl -sL \"https://script.google.com/macros/s/AKfycbwdSLK3K9_D39sc0UfzYZIM1QEMLxMUudSneAELoqcJjM5ExTSq7ZmMilNzYDx5QK5iMA/exec?action=health\""
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vitest": "^4.1.11"
  }
}
